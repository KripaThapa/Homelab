# Manual only: excluded from directory apply by .template suffix; suspended as a second safeguard.
# Create this exact file explicitly, then unsuspend only when authorized. See README.md.
apiVersion: batch/v1
kind: Job
metadata:
  name: market-migration
  namespace: market-research
  labels:
    app: market-migration
spec:
  suspend: true
  backoffLimit: 0
  template:
    metadata:
      labels:
        app: market-migration
    spec:
      automountServiceAccountToken: false
      containers:
      - name: migration
        image: ghcr.io/kripathapa/market-scanner/application:sha-3875a67
        imagePullPolicy: IfNotPresent
        command:
        - python
        - -m
        - alembic
        - upgrade
        - head
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 512Mi
        env:
        - name: POSTGRES_DB
          valueFrom:
            secretKeyRef:
              name: market-scanner-db
              key: POSTGRES_DB
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef:
              name: market-scanner-db
              key: POSTGRES_USER
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: market-scanner-db
              key: POSTGRES_PASSWORD
        workingDir: /app
      restartPolicy: Never
